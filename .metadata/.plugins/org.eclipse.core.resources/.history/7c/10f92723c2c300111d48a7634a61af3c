		if(count==AppConstants.DASHBOARD_PAGE_CARDS_COUNT) {
			flag=true;
			
		}
		else {
			flag=false;
		}
		Assert.assertTrue(flag, "card should be "+ AppConstants.DASHBOARD_PAGE_CARDS_COUNT+" but it is "+count);
		
	}
