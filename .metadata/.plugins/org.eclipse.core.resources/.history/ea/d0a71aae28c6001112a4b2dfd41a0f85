package Pages;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;

import constants.AppConstants;
import utilities.ElementUtils;

public class allPlanPage {

	
	private WebDriver driver;
	private ElementUtils eleUtil;
	
	public allPlanPage(WebDriver driver) {
		this.driver=driver;
		eleUtil=new ElementUtils(this.driver);
	}
	
	
	private By planRows=By.xpath("//tr[@class='ant-table-row ant-table-row-level-0']");
	private By nextPage=By.xpath("//li[@title='Next Page']");
	private By exportBtn=By.xpath("//span[@aria-label='export']");
	private By disabledNextBtn=By.xpath("//li[@class='ant-pagination-next ant-pagination-disabled']");
	
	
	public int getPlanCount() throws InterruptedException {
		int i=1;
		Thread.sleep(8000);
		List<WebElement> allPlanCountPage=eleUtil.safeGetWebElement(planRows);
		int count=allPlanCountPage.size();
		System.out.println(allPlanCountPage.size());
		while(eleUtil.getElement(disabledNextBtn).isDisplayed()) {
			Thread.sleep(5000);
			System.out.println("I am in while loop");
			eleUtil.doClick(nextPage);
			Thread.sleep(5000);
			List<WebElement> l2=eleUtil.safeGetWebElement(planRows);
			count=count+l2.size();
			
			
		}
		
		return count;
	}
	
	public void clickExportBtn() {
		eleUtil.doClick(exportBtn);
	}
	
}
