package Pages;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;

import constants.AppConstants;
import utilities.ElementUtils;

public class allPlanPage {

	
	private WebDriver driver;
	private ElementUtils eleUtil;
	
	public allPlanPage(WebDriver driver) {
		this.driver=driver;
		eleUtil=new ElementUtils(this.driver);
	}
	
	
	private By planRows=By.xpath("//tr[@class='ant-table-row ant-table-row-level-0']");
	private By nextPage=By.xpath("//li[@class='ant-pagination-next']");
	private By exportBtn=By.xpath("//span[@aria-label='export']");
	
	
	public int getPlanCount() {
		int i=1;
		List<WebElement> allPlanCountPage=eleUtil.waitForVisibilityOfElements(planRows, AppConstants.LONG_DEFAUTT_WAIT);
		while(eleUtil.getElement(nextPage).isEnabled()) {
			eleUtil.doClick(nextPage);
			allPlanCountPage.addAll(eleUtil.waitForVisibilityOfElements(planRows, AppConstants.LONG_DEFAUTT_WAIT));
			
		}
		
		return allPlanCountPage.size();
	}
	
	public void clickExportBtn() {
		eleUtil.doClick(exportBtn);
	}
	
}
