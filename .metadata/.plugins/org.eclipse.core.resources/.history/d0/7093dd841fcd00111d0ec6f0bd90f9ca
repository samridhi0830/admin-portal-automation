	public int getPlanCountFromCSV() throws IOException {

	    String downloadPath = "/Users/toffee/eclipse-workspace/Admin_portal_automation/qa-admin-portal/Downloads";

	    File folder = new File(downloadPath);
	    

	    // Find downloaded CSV files
	    File[] csvFiles = folder.listFiles(
	        (dir, name) -> name.endsWith(".csv")
	    );
	    

	    if (csvFiles == null || csvFiles.length == 0) {
	        throw new RuntimeException("CSV file not found!");
	    }
	    

	    // Get the CSV file
	    File csvFile = csvFiles[0];

	    System.out.println("CSV File: " + csvFile.getAbsolutePath());
	    

	    // Count plans, excluding the header row
	    long planCount;

	    try (Stream<String> lines = Files.lines(csvFile.toPath())) {
	        planCount = Math.max(0, lines.count() - 1);
	    }
	    

	    System.out.println("Total plans in CSV: " + planCount);
	    

	    return (int) planCount;
	    
	}
	
