	public String planSold() {
		String TotalPlanSold=eleUtil.waitForVisibilityOfElement(planSold, AppConstants.LONG_DEFAUTT_WAIT).getText();
		LoggerUtil.info("Plan sold count on dashboard = "+ TotalPlanSold);
		return TotalPlanSold;
	}
	
	public allPlanPage moveToPlansPage() {
		eleUtil.waitForVisibilityOfElement(plans, AppConstants.LONG_DEFAUTT_WAIT).click();
		eleUtil.waitForVisibilityOfElement(allPlans, AppConstants.LONG_DEFAUTT_WAIT).click();
		return new allPlanPage(driver);
		
